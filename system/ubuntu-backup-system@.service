[Unit]
Description=Capture system-wide configuration for Ubuntu Backup (owner %i)
Documentation=https://github.com/scripting-drafts/Ubuntu-Backup
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/libexec/ubuntu-backup/ubuntu-backup-system --owner %i
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i
SuccessExitStatus=3
TimeoutStartSec=20min
