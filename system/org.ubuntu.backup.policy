<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Ubuntu Backup</vendor>
  <vendor_url>https://github.com/scripting-drafts/Ubuntu-Backup</vendor_url>

  <action id="org.ubuntu.backup.capture">
    <description>Capture system-wide configuration</description>
    <message>Authentication is required to capture system-wide configuration for Ubuntu Backup.</message>
    <defaults>
      <allow_active>auth_admin_keep</allow_active>
      <allow_inactive>auth_admin_keep</allow_inactive>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ubuntu-backup/ubuntu-backup-system</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
